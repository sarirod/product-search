# Copy this file to .env (which is git-ignored) and fill in real values.
# On Render these are set as Environment Variables in the dashboard instead.

# Neon Postgres connection string (Dashboard -> Connection string)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Google AI Studio API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional: override the embedding model (default: gemini-embedding-001)
# GEMINI_EMBED_MODEL=gemini-embedding-001
